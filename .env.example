# Copy to .env.local and fill in. Never commit .env.local.

# AI: Vercel AI Gateway (monthly free credit). Vercel dashboard → AI Gateway → API Keys.
# On Vercel itself the deployment authenticates automatically, so this is for local use.
AI_GATEWAY_API_KEY=
# Which models to use: comma-separated Gateway ids, rotated to spread the free tier's
# 5-requests-a-minute-per-model limit. Leave empty for the defaults. Check: npm run check
DRYRUN_CLONE_MODEL=openai/gpt-4.1-mini,openai/gpt-4o-mini,google/gemini-2.5-flash-lite
DRYRUN_SMART_MODEL=openai/gpt-5-mini,google/gemini-2.5-flash

# Supabase: Project Settings → API. The SECRET key stays on the server; the browser
# never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: who can sign in (default uchicago.edu)
# ALLOWED_EMAIL_DOMAIN=uchicago.edu
