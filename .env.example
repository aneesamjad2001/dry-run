# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic: a key from a "Dry Run" workspace with a monthly spend limit set.
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API. The SECRET key stays on the server; the browser
# never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: who can sign in (default uchicago.edu)
# ALLOWED_EMAIL_DOMAIN=uchicago.edu
